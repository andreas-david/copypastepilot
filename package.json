{
  "name": "@andreasdavid/easycopy",
  "version": "0.1.0",
  "description": "Kopiert Felder von einem Programmfenster in ein anderes – lokal, über die Bedienungshilfen",
  "keywords": [
    "copy",
    "paste",
    "automation",
    "accessibility",
    "forms",
    "agent-desktop",
    "macos"
  ],
  "author": "Andreas David",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreas-david/easycopy.git"
  },
  "homepage": "https://github.com/andreas-david/easycopy#readme",
  "bugs": {
    "url": "https://github.com/andreas-david/easycopy/issues"
  },
  "type": "module",
  "bin": {
    "easycopy": "bin/cli.js"
  },
  "files": [
    "bin",
    "server",
    "!server/*.test.js",
    "web-dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev:web": "vite web",
    "build": "vite build web",
    "start": "node bin/cli.js",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "agent-desktop": "^1.3.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "svelte": "^5.0.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
